# ============================================================
# Frontend Environment Variables
# Copy to .env and fill in your values before deploying.
# ============================================================

# URL the nginx container proxies /api and /ws requests to.
# Should be the full URL of your deployed backend service.
# Example: http://api.yourdomain.com:8000
NGINX_BACKEND_URL=http://localhost:8000

# (Optional) If you want the browser to call the backend directly
# instead of going through the nginx proxy, set this to the
# public backend URL.  Leave empty to use the nginx proxy (recommended).
VITE_API_URL=
