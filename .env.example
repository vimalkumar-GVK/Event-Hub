# Frontend Configuration
VITE_API_URL=/api

# Backend Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smart-campus
SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://localhost:5173,https://your-project.vercel.app

# Storage Configuration
# Set to "local" for development, "s3" or "cloudinary" for production object storage
STORAGE_PROVIDER=local
