# ============================================================
# Backend Environment Variables
# Copy to .env and fill in your values before deploying.
# ============================================================

# JWT secret — use a long random string in production
SECRET_KEY=your-secret-key-here

# MongoDB URI (leave empty to use in-memory mongomock for development)
MONGO_URI=mongodb://localhost:27017/smartcampus

# PostgreSQL (used by alembic migrations & optional SQL features)
POSTGRES_DB=campusdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Comma-separated list of allowed frontend origins for CORS.
# In production set this to your frontend's domain.
# Example: https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
